@{
    ViewData["Title"] = "Promos";
}

<section class="rg-page-header">
    <p class="rg-eyebrow">Promos</p>
    <h1>Exclusive <span class="rg-gold">offers</span></h1>
    <p>Save more while you train. Check our current gym discounts.</p>
</section>

<section class="rg-section">
    <div class="rg-grid rg-grid-3">
        <div class="rg-info-card rg-promo">
            <span class="rg-badge">20% OFF</span>
            <h4>New Member Promo</h4>
            <p>Get 20% off your first month when you sign up this season.</p>
            <a href="#" class="rg-btn rg-btn-gold rg-btn-sm">Claim Offer</a>
        </div>
        <div class="rg-info-card rg-promo">
            <span class="rg-badge">BUY 1 TAKE 1</span>
            <h4>Bring a Buddy</h4>
            <p>Sign up with a friend and one of you joins free for a month.</p>
            <a href="#" class="rg-btn rg-btn-gold rg-btn-sm">Claim Offer</a>
        </div>
        <div class="rg-info-card rg-promo">
            <span class="rg-badge">STUDENT</span>
            <h4>Student Discount</h4>
            <p>Show a valid school ID for a special student membership rate.</p>
            <a href="#" class="rg-btn rg-btn-gold rg-btn-sm">Claim Offer</a>
        </div>
    </div>
</section>