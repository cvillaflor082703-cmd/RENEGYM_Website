@{
    ViewData["Title"] = "About";
}

<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap" rel="stylesheet" />

<section class="rg-about">
    <div class="rg-about-band">
        <div class="rg-about-content">
            <h1 class="rg-about-title">
                DISCIPLINE BUILDS<br />
                <span class="rg-gold">A BETTER YOU</span>
            </h1>

            <div class="rg-about-divider"></div>

            <p class="rg-about-est">RENEGYM &middot; Est. 2026</p>

            <p class="rg-about-text">
