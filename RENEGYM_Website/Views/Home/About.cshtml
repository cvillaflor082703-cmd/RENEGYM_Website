@{
    ViewData["Title"] = "About";
}

<link rel="stylesheet" href="~/css/about.css" asp-append-version="true" />

<section class="rg-about">
    <div class="rg-about-band">

        <ul class="rg-about-values">
            <li>Fitness</li>
            <li>Community</li>
            <li>Progress</li>
            <li>Discipline</li>
        </ul>

        <div class="rg-about-center">
            <h1 class="rg-about-title">
                DISCIPLINE BUILDS<br />
                <span class="rg-about-gold">A BETTER YOU</span>
            </h1>

            <div class="rg-about-line"></div>

            <p class="rg-about-est">RENEGYM . Est . 2026</p>

            <p class="rg-about-text">
                Members check in with a personal QR code, so every visit is saved
                to their attendance record. Staff see who is in the gym, and
                coaches see who is booked with them.
            </p>
        </div>

        <div class="rg-about-quote">Discipline builds freedom</div>

    </div>
</section>