@{
    ViewData["Title"] = "Membership";
}

<section class="rg-mem">

    <div class="rg-mem-head">
        <h1 class="rg-mem-title">MEMBERSHIP <span class="rg-mem-gold">RATES</span></h1>
        <p class="rg-mem-sub">
            All prices are in Philippine pesos (₱). Pay at the<br />
            front desk, by GCash, Maya, or card.
        </p>
    </div>

    <div class="rg-mem-plans">

        <div class="rg-mem-card">
            <p class="rg-mem-plan-name">MONTHLY</p>
            <p class="rg-mem-price">₱1,200</p>
            <p class="rg-mem-note">per month</p>

            <ul class="rg-mem-list">
                <li><i class="fa-solid fa-check"></i> Unlimited gym access</li>
                <li><i class="fa-solid fa-check"></i> QR attendance check-in</li>
                <li><i class="fa-solid fa-check"></i> Online coach booking</li>
                <li><i class="fa-solid fa-check"></i> Locker use</li>
            </ul>

            <a href="#" class="rg-mem-btn rg-mem-btn-outline">Choose Monthly</a>
        </div>

        <div class="rg-mem-card rg-mem-card-featured">
            <span class="rg-mem-badge">Best Offer</span>

            <p class="rg-mem-plan-name">QUARTERLY</p>
            <p class="rg-mem-price">₱3,300</p>
            <p class="rg-mem-note">3 months &middot; ₱1,100 a month</p>

            <ul class="rg-mem-list">
                <li><i class="fa-solid fa-check"></i> Everything in Monthly</li>
                <li><i class="fa-solid fa-check"></i> 1 free coach session</li>
                <li><i class="fa-solid fa-check"></i> 7-day membership freeze</li>
                <li><i class="fa-solid fa-check"></i> Guest Pass up to 10 times.</li>
            </ul>

            <a href="#" class="rg-mem-btn rg-mem-btn-gold">Choose Quarterly</a>
        </div>

        <div class="rg-mem-card">
            <p class="rg-mem-plan-name">ANNUAL</p>
            <p class="rg-mem-price">₱11,500</p>
            <p class="rg-mem-note">12 months &middot; ₱958 a month</p>

            <ul class="rg-mem-list">
                <li><i class="fa-solid fa-check"></i> Everything in Quarterly</li>
                <li><i class="fa-solid fa-check"></i> 4 free coach sessions</li>
                <li><i class="fa-solid fa-check"></i> 30-day membership freeze</li>
                <li><i class="fa-solid fa-check"></i> Free RENEGYM shirt</li>
            </ul>

            <a href="#" class="rg-mem-btn rg-mem-btn-outline">Choose Annual</a>
        </div>

    </div>

    <div class="rg-mem-extras">
        <p>
            Day pass <strong>₱150</strong>
            <span class="rg-mem-gap"></span>
            Coach session <strong>₱500</strong>
            <span class="rg-mem-gap"></span>
            Registration fee <strong>₱300</strong>
        </p>
        <p class="rg-mem-sample">Sample rates. Admins can change them in the admin dashboard.</p>
    </div>

</section>