@{
    ViewData["Title"] = "Membership";
}

<section class="rg-page-header">
    <p class="rg-eyebrow">Membership</p>
    <h1>Choose your <span class="rg-gold">plan</span></h1>
    <p>Flexible plans for every goal. Manage and renew anytime.</p>
</section>

<section class="rg-section">
    <div class="rg-grid rg-grid-3">
        <div class="rg-plan">
            <h4>Monthly</h4>
            <div class="rg-price">&#8369;999<small>/month</small></div>
            <ul>
                <li><i class="fa-solid fa-check"></i> 24/7 gym access</li>
                <li><i class="fa-solid fa-check"></i> QR attendance</li>
                <li><i class="fa-solid fa-check"></i> Online session booking</li>
            </ul>
            <a href="#" class="rg-btn rg-btn-outline">Select Plan</a>
        </div>

        <div class="rg-plan rg-plan-featured">
            <span class="rg-badge">Most Popular</span>
            <h4>Quarterly</h4>
            <div class="rg-price">&#8369;2,699<small>/3 months</small></div>
            <ul>
                <li><i class="fa-solid fa-check"></i> Everything in Monthly</li>
                <li><i class="fa-solid fa-check"></i> 2 free coach sessions</li>
                <li><i class="fa-solid fa-check"></i> Priority booking</li>
            </ul>
            <a href="#" class="rg-btn rg-btn-gold">Select Plan</a>
        </div>

        <div class="rg-plan">
            <h4>Annual</h4>
            <div class="rg-price">&#8369;9,999<small>/year</small></div>
            <ul>
                <li><i class="fa-solid fa-check"></i> Everything in Quarterly</li>
                <li><i class="fa-solid fa-check"></i> 6 free coach sessions</li>
                <li><i class="fa-solid fa-check"></i> Free RENEGYM shirt</li>
            </ul>
            <a href="#" class="rg-btn rg-btn-outline">Select Plan</a>
        </div>
    </div>
</section>