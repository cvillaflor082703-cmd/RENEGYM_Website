@{
    ViewData["Title"] = "Home";
}

<section class="rg-hero">
    <div class="rg-hero-content">
        <p class="rg-tagline">
            Stronger <span>&bull;</span> Fitter <span>&bull;</span> A Better You
        </p>

        <h1 class="rg-title">
            TRAIN WITHOUT<br />
            <span class="rg-gold">LIMITS</span>
        </h1>

        <p class="rg-subtitle">
            Premium gym experience for everyone.
            Book sessions, manage memberships, and track attendance with RENEGYM.
        </p>

        <div class="rg-hero-buttons">
            <a href="#" class="rg-btn rg-btn-gold">
                Join Now <i class="fa-solid fa-arrow-right"></i>
            </a>

            <a href="#" class="rg-btn rg-btn-outline">
                Book Session
            </a>
        </div>

        <div class="rg-stats">
            <div class="rg-stat">
                <strong>100+</strong>
                <span>
                    Active<br />
                    Members
                </span>
            </div>
            <div class="rg-stat rg-stat-divided">
                <strong>4</strong>
                <span>
                    Professional<br />
                    Trainers
                </span>
            </div>
            <div class="rg-stat">
                <strong>24/7</strong>
                <span>Gym Access</span>
            </div>
        </div>
    </div>

    <div class="rg-quote">
        Discipline builds freedom
    </div>

    <div class="rg-cards">
        <a href="#" class="rg-card">
            <i class="fa-solid fa-dumbbell"></i>
            <div>
                <h5>MEMBERSHIP</h5>
                <p>Manage and renew your membership anytime.</p>
            </div>
        </a>
        <a href="#" class="rg-card">
            <i class="fa-regular fa-calendar"></i>
            <div>
                <h5>BOOK SESSION</h5>
                <p>Easily book your favorite coaches online.</p>
            </div>
        </a>
        <a href="#" class="rg-card">
            <i class="fa-solid fa-qrcode"></i>
            <div>
                <h5>QR ATTENDANCE</h5>
                <p>Fast and secure attendance tracking.</p>
            </div>
        </a>
        <a href="#" class="rg-card">
            <i class="fa-solid fa-tag"></i>
            <div>
                <h5>PROMOS</h5>
                <p>Exclusive gym discounts and offers.</p>
            </div>
        </a>
    </div>
</section>