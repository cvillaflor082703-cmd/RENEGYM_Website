@{
    ViewData["Title"] = "Trainers";
}

<section class="rg-tr">

    <div class="rg-tr-head">
        <h1 class="rg-tr-title">BOOK A <span class="rg-tr-gold">COACH</span></h1>
        <p class="rg-tr-sub">
            Pick a trainer, choose a time, and show your QR<br />
            code when you arrive.
        </p>
    </div>

    <div class="rg-tr-grid">

        <div class="rg-tr-card">
            <div class="rg-tr-avatar">
                <img src="~/images/lance.jpg" alt="Coach Lance" />
            </div>
            <p class="rg-tr-label">COACH</p>
            <p class="rg-tr-name">LANCE</p>
            <p class="rg-tr-role">Boxing and<br />cardio</p>
        </div>

        <div class="rg-tr-card">
            <div class="rg-tr-avatar">
                <img src="~/images/jay.jpg" alt="Coach Jay" />
            </div>
            <p class="rg-tr-label">COACH</p>
            <p class="rg-tr-name">JAY</p>
            <p class="rg-tr-role">Strength and<br />conditioning</p>
        </div>

        <div class="rg-tr-card">
            <div class="rg-tr-avatar">
                <img src="~/images/renz.jpg" alt="Coach Renz" />
            </div>
            <p class="rg-tr-label">COACH</p>
            <p class="rg-tr-name">RENZ</p>
            <p class="rg-tr-role">Body<br />building</p>
        </div>

        <div class="rg-tr-card">
            <div class="rg-tr-avatar">
                <img src="~/images/camila.jpg" alt="Coach Camila" />
            </div>
            <p class="rg-tr-label">COACH</p>
            <p class="rg-tr-name">CAMILA</p>
            <p class="rg-tr-role">Yoga<br />Fitness</p>
        </div>

    </div>

</section>